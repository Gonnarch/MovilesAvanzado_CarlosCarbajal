                  <constraint firstItem="confirmacion-stack" firstAttribute="trailing" secondItem="confirmacion-content" secondAttribute="trailing" constant="-24" id="confirmacion-sc-r" />
                  <constraint firstItem="confirmacion-stack" firstAttribute="top" secondItem="confirmacion-content" secondAttribute="top" constant="24" id="confirmacion-sc-t" />
                  <constraint firstItem="confirmacion-stack" firstAttribute="bottom" secondItem="confirmacion-content" secondAttribute="bottom" constant="-24" id="confirmacion-sc-b" />
                  <constraint firstItem="confirmacion-stack" firstAttribute="width" secondItem="confirmacion-frame" secondAttribute="width" constant="-48" id="confirmacion-width" />
